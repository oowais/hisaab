# Hisaab, packaged from the release .deb (what an AUR hisaab-bin would be).
# CI fills in @VERSION@ and @SHA256@ and attaches the result to each release
# as PKGBUILD; scripts/install-arch.sh builds and installs it with makepkg.
# Maintainer: oowais <https://github.com/oowais>

pkgname=hisaab-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Private, local-first tracker for subscriptions and bills"
arch=('x86_64')
url="https://github.com/oowais/hisaab"
license=('GPL-3.0-or-later')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'hicolor-icon-theme')
provides=('hisaab')
conflicts=('hisaab')
source=("hisaab_${pkgver}_amd64.deb::${url}/releases/download/v${pkgver}/hisaab_${pkgver}_amd64.deb")
sha256sums=('@SHA256@')

package() {
  bsdtar -xf data.tar.gz -C "$pkgdir"
  # Tauri names the 2x icon folder "256x256@2"; the icon theme wants 256x256.
  local icons="$pkgdir/usr/share/icons/hicolor"
  if [ -d "$icons/256x256@2" ]; then
    mkdir -p "$icons/256x256"
    mv "$icons/256x256@2/apps" "$icons/256x256/"
    rmdir "$icons/256x256@2"
  fi
}
